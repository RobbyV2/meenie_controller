(version 1)

# Plated through-hole clearances are separate from the 0.200 mm NPTH setup rule.
# Product tests prove that the release fails when a required rule or geometry changes.
(rule "PTH hole to copper"
	(constraint hole_clearance (min 0.28mm))
	(severity error)
	(condition "A.Pad_Type == 'Through-hole'"))

(rule "PTH hole to PTH hole"
	(constraint hole_to_hole (min 0.45mm))
	(severity error)
	(condition "A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'"))

# Keep zones away from all three RF nets on the outer layers. RF_50 has the
# stronger, released B.Cu rule below. Pad-internal shunt gaps are outside scope.
(rule "RF corridor coplanar setback"
	(constraint clearance (min 0.22mm))
	(layer outer)
	(severity error)
	(condition "(A.NetName == 'RF_50' || A.NetName == 'ANT_FEED' || A.NetName == 'RF_CHIP') && B.Type == 'Zone'"))

# The U1 north pocket holds only low-voltage crystal and internal-regulator nets.
# Its exact 0.090 mm net-to-GND clearance is scoped to the named B.Cu rule area.
(rule "U1 north pocket crystal and decoupling escape"
	(constraint clearance (min 0.09mm))
	(severity error)
	(condition "(A.NetName == 'XC2' || A.NetName == 'DEC4_6') && B.NetName == 'GND' && A.insideArea('U1 north pocket')"))


# NextPCB Advanced HDI publishes 0.05/0.05 mm copper geometry, a 0.075 mm
# laser drill, and +/-0.05 mm registration.  This release holds copper spacing
# at 0.08 mm and laser-hole-to-foreign-copper spacing at 0.08 mm.  Mechanical
# holes remain governed by the board and PTH rules.
(rule "NextPCB Advanced HDI copper clearance"
    (constraint clearance (min 0.08mm))
    (severity error)
    (condition "A.Type == 'Track' || A.Type == 'Via' || A.Type == 'Pad' || A.Type == 'Zone'"))

(rule "NextPCB Advanced HDI laser hole clearance"
    (constraint hole_clearance (min 0.08mm))
    (severity error)
    (condition "A.Via_Type == 'Micro'"))

# Mechanical vias retain the published 1 oz annular-ring floor.  Laser vias
# are 0.250/0.100 mm and therefore carry 0.075 mm rings.
(rule "NextPCB mechanical via annular ring"
    (constraint annular_width (min 0.09mm))
    (severity error)
    (condition "A.Type == 'Via' && A.Via_Type != 'Micro'"))


# RF_50 is a masked B.Cu microstrip over the adjacent In6.Cu GND plane.
# The rule-area polygon is drawn for 0.310 mm;
# 0.300 mm here is the hard copper-edge release floor after fill tessellation.
(rule "NextPCB HDI RF_50 B.Cu width"
    (constraint track_width (min 0.17mm) (max 0.17mm))
    (severity error)
    (condition "A.NetName == 'RF_50' && A.Layer == 'B.Cu'"))
(rule "NextPCB HDI RF_50 same-side GND setback"
    (constraint clearance (min 0.300mm))
    (severity error)
    (condition "A.NetName == 'RF_50' && A.Layer == 'B.Cu' && B.Type == 'Zone' && A.insideArea('RF corridor, RF_50')"))


# Different-net via copper must retain at least 3 mil.  Same-net sequential
# capture is checked structurally by the stack manifest instead of emitted as
# a native DRC error.
(rule "via physical copper clearance, different nets"
    (constraint physical_clearance (min 0.075mm))
    (severity error)
    (condition "A.Type == 'Via' && B.Type == 'Via' && A.Net != B.Net"))
