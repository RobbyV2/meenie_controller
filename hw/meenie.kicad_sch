		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "ba95b3b8-fc96-55a0-a48d-a494c1e63d09")
	)
	(text "C1 and C2 are the 12 pF NP0 2% load capacitors. No LFXO: the calibrated LFRC"
