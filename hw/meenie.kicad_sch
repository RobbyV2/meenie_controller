	(text "C21 is fitted on build codes Dxx and earlier, which is what the -R order code ships."
		(exclude_from_sim no)
		(at 20.32 144.78 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "2ef20818-9ddb-5042-8ed1-7975f3443d90")
	)
	(text "It is not required on Fxx and later. C9 carries CDECUSB, 2.35 uF minimum after bias."
		(exclude_from_sim no)
		(at 20.32 149.86 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "904f5cdd-a270-50bc-ae1d-326efb5617cb")
	)
	(text "32 MHz HFXO. Y1 is 32.000 MHz, CL 8 pF, FA-118T 1612 four pad."
