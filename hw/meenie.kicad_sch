	(text "Twenty surface pads on B.Cu, 0.60 mm square. W1 to W9 with S1 and S2 sit on the north"
		(exclude_from_sim no)
		(at 443.23 40.64 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "138763d8-7cc4-584d-9617-18e61e7c46a1")
	)
	(text "rail at y 9.000, E1 to E9 on the east rail at x 12.100. Thirteen GPIO, seven of them"
		(exclude_from_sim no)
		(at 443.23 45.72 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "81f72f1c-5c4c-5a64-89c7-3609177b9d4f")
	)
	(text "SAADC capable, two grounds, 3V3 out, VBUS in and unfused, nRESET for double-tap DFU,"
		(exclude_from_sim no)
		(at 443.23 50.8 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "f9ec427b-0563-59be-befc-9874ef3cea5a")
	)
	(text "and the two SWD pads. Every GPIO sits on a U1 pin with a measured via-in-pad seat, so"
		(exclude_from_sim no)
		(at 443.23 55.88 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "9746df6d-2d6f-5de8-8d60-e85ebfef5a94")
	)
	(text "the escape is a drop onto In2. AIN0 E5, AIN1 W5, AIN3 E2, AIN4 W6, AIN5 E4, AIN6 W7,"
		(exclude_from_sim no)
		(at 443.23 60.96 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "4300c73e-7a9a-5fbc-8c9b-d5ea8c1c73b1")
	)
	(text "AIN7 E3. AIN2 on J1 is the one channel no breakout pad carries."
		(exclude_from_sim no)
		(at 443.23 66.04 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "f4d9b466-6aff-5e07-b9dc-f5993c6bcdd7")
	)
